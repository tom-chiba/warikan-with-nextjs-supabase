{
  "permissions": {
    "allow": [
      "Edit(/app/**/*)",
      "Edit(/components/**/*)",
      "Edit(/docs/**/*)",
      "Write(/app/**/*)",
      "Write(/components/**/*)",
      "Write(/docs/**/*)",
      "WebFetch",
      "WebSearch",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(npm run tsc)",
      "Bash(npm run biome:check)",
      "Bash(npm run biome:format)",
      "Bash(npm run check)",
      "Bash(npm run test:comp *)",
      "Bash(npm run test:e2e *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git branch)",
      "Bash(git remote)",
      "Bash(gh repo view *)",
      "Bash(gh issue create *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr diff *)",
      "mcp__plugin_playwright_playwright__*"
    ],
    "deny": [
      "Read(.env*)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  }
}
